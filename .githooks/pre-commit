#!/bin/sh
# Gancho del equipo: a main no se escribe directamente, todo entra por PR.
# Vale para cualquier herramienta y para las personas, porque lo ejecuta git.
# Se activa una vez por clon:  git config core.hooksPath .githooks

rama=$(git symbolic-ref --short -q HEAD)
if [ "$rama" = "main" ]; then
    echo "pre-commit: en main no se hace commit; todo entra por PR." >&2
    echo "  Crea la rama de la orden: git switch -c <usuario>/orden-N" >&2
    exit 1
fi
exit 0
